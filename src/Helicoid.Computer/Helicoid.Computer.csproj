<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Helicoid.Computer</RootNamespace>
    <AssemblyName>Helicoid.Computer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Development bundle: x64 + unpackaged. Packaged .NET apps cannot be
         ProcessorArchitecture neutral; Platform and RID stay pinned to win-x64.
         Unsigned development output uses WindowsPackageType=None (CI-verified). -->
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyTitle>Helicoid Computer</AssemblyTitle>
    <Product>Helicoid</Product>
    <Company>Helicoid Systems</Company>
    <!-- Role-specific Explorer PE icon from branding/generated. -->
    <ApplicationIcon>..\..\branding\generated\hs-computer-windowsicon.ico</ApplicationIcon>
    <!-- Produced by the pinned modules/core/webrtc-native Windows build. -->
    <NativeWebRtcDllPath Condition="'$(NativeWebRtcDllPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\modules\core\webrtc-native\inventory\hs_webrtc_shared.dll</NativeWebRtcDllPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\brand\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NativeWebRtcDllPath)" Condition="Exists('$(NativeWebRtcDllPath)')">
      <Link>hs_webrtc_shared.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Staged beside the published exe for AppWindow.SetIcon (AppContext.BaseDirectory). -->
    <Content Include="..\..\branding\generated\hs-computer-windowsicon.ico">
      <Link>hs-computer-windowsicon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helicoid.Domain\Helicoid.Domain.csproj" />
    <ProjectReference Include="..\Helicoid.WindowsPlatform\Helicoid.WindowsPlatform.csproj" />
    <ProjectReference Include="..\Helicoid.CaptureWorker\Helicoid.CaptureWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="StageCaptureWorkerForBuild" AfterTargets="Build">
    <ItemGroup>
      <_CaptureWorkerBuildOutput Include="$(MSBuildThisFileDirectory)..\Helicoid.CaptureWorker\bin\$(Configuration)\net10.0\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CaptureWorkerBuildOutput)"
          DestinationFiles="@(_CaptureWorkerBuildOutput->'$(OutDir)CaptureWorker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCaptureWorker" BeforeTargets="Publish">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Helicoid.CaptureWorker\Helicoid.CaptureWorker.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(PublishDir)CaptureWorker\" />
  </Target>

  <Target Name="ValidateNativeWebRtcDll" BeforeTargets="PrepareForBuild" Condition="'$(RequireNativeWebRtc)' == 'true'">
    <Error Condition="!Exists('$(NativeWebRtcDllPath)')"
           Text="NativeWebRtcDllPath must name the pinned hs_webrtc_shared.dll when RequireNativeWebRtc=true." />
  </Target>

</Project>
