<Window
    x:Class="Helicoid.Computer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock
                Text="Helicoid Computer"
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center"
                Margin="16,0,0,0" />
        </Grid>

        <!-- Compact endpoint status: connection and screen-access identity once.
             Technical details collapse behind View Details. -->
        <Grid Grid.Row="1" Padding="16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                x:Name="ConnectionText"
                Text="Not enrolled"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="1"
                x:Name="AccessText"
                Text=""
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="2"
                x:Name="FailureText"
                Text=""
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <TextBlock
                Grid.Row="3"
                x:Name="FileDeliveryText"
                Text="File delivery is not configured."
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="EnrollEndpointButton"
                    HorizontalAlignment="Left"
                    Padding="8,4"
                    Click="EnrollEndpointButton_Click"
                    AutomationProperties.Name="Enroll this computer">
                    <TextBlock Text="Enroll this computer" />
                </Button>

                <Button
                    x:Name="ForgetEndpointIdentityButton"
                    HorizontalAlignment="Left"
                    Padding="8,4"
                    Click="ForgetEndpointIdentityButton_Click"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Forget saved endpoint identity">
                    <TextBlock Text="Forget saved identity" />
                </Button>

                <Button
                    x:Name="ViewDetailsButton"
                    HorizontalAlignment="Left"
                    Padding="8,4"
                    Click="ViewDetailsButton_Click"
                    AutomationProperties.Name="View Details">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            x:Name="DetailsChevron"
                            Glyph="&#xE70D;"
                            FontSize="12"
                            VerticalAlignment="Center" />
                        <TextBlock x:Name="ViewDetailsLabel" Text="View Details" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="OpenReceivedFilesButton"
                    HorizontalAlignment="Left"
                    Padding="8,4"
                    Click="OpenReceivedFilesButton_Click"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Open received files">
                    <TextBlock Text="Open Received Files" />
                </Button>

                <Button
                    x:Name="ReviewFileRequestsButton"
                    HorizontalAlignment="Left"
                    Padding="8,4"
                    Click="ReviewFileRequestsButton_Click"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Review file requests">
                    <TextBlock Text="Review File Requests" />
                </Button>
            </StackPanel>

            <ScrollViewer
                Grid.Row="6"
                x:Name="DetailsScroll"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock x:Name="SupervisorText" Text="Supervisor: No supervisor" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WorkerText" Text="Worker: No worker" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="GenerationText" Text="Generation: 0" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="StopControlNoteText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
