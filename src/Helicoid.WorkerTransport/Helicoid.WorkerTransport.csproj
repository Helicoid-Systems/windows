<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Helicoid.WorkerTransport</RootNamespace>
    <AssemblyName>Helicoid.WorkerTransport</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helicoid.Domain\Helicoid.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helicoid.WindowsPlatform" />
    <InternalsVisibleTo Include="Helicoid.CaptureWorker" />
    <InternalsVisibleTo Include="Helicoid.WindowsIntegrationTests" />
  </ItemGroup>

</Project>
