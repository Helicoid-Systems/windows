<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RootNamespace>Helicoid.CaptureWorker</RootNamespace>
    <AssemblyName>Helicoid.CaptureWorker</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The per-user worker ships with its runtime so endpoint deployment does
         not depend on a separately installed .NET runtime. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helicoid.Domain\Helicoid.Domain.csproj" />
    <ProjectReference Include="..\Helicoid.WorkerTransport\Helicoid.WorkerTransport.csproj" />
  </ItemGroup>

</Project>
