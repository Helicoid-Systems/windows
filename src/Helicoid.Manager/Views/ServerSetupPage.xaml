<Page
    x:Class="Helicoid.Manager.Views.ServerSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Helicoid.Manager.ViewModels"
    xmlns:views="using:Helicoid.Manager.Views">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Name="TaskTitle" Text="Set Up Server" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="RouteSummaryText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Title="Server installation is unavailable in this build"
                Message="This app shows the available setup steps. It does not install or change server software on this computer." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="552" HorizontalAlignment="Left">

                <!-- H01 Choose Hosting -->
                <StackPanel x:Name="ChooseHostingPanel" Spacing="12">
                    <TextBlock Text="Choose where the server will run." TextWrapping="Wrap" />
                    <StackPanel Spacing="8">
                        <RadioButton
                            x:Name="WindowsLocalChoice"
                            GroupName="HostingRoute"
                            Tag="WindowsLocal"
                            Checked="HostingRoute_Checked"
                            AutomationProperties.Name="This Computer">
                            <StackPanel Spacing="2">
                                <TextBlock Text="This Computer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Local Windows hosting."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="LinuxSshChoice"
                            GroupName="HostingRoute"
                            Tag="LinuxSsh"
                            Checked="HostingRoute_Checked"
                            AutomationProperties.Name="Existing Linux Server">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Existing Linux Server" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Remote Linux hosting over SSH."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <!-- H02 Local Host -->
                <StackPanel x:Name="LocalHostPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="This Windows computer would host the server." TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LocalComputerText" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Operating system" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LocalOsText" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Architecture" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LocalArchitectureText" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Install scope" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Not checked." TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <!-- H03 Connect -->
                <StackPanel x:Name="SshConnectPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Enter the existing Linux server's SSH address." TextWrapping="Wrap" />
                    <TextBox
                        x:Name="SshAddressBox"
                        Header="SSH address"
                        PlaceholderText="ubuntu@server.example.com"
                        TextChanged="SshAddressBox_TextChanged"
                        AutomationProperties.Name="SSH address" />
                    <TextBlock
                        Text="Uses a key from your SSH agent. The address is not contacted in this build."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- H04 Host Identity -->
                <StackPanel x:Name="SshIdentityPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="SSH host identity" TextWrapping="Wrap" />
                    <TextBlock
                        Text="This build cannot verify the SSH host identity, so setup cannot continue from this step."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- H05 Check Host -->
                <StackPanel x:Name="CheckHostPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="CheckHostSummary" TextWrapping="Wrap" />
                    <ItemsControl x:Name="HostCheckList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupHostCheckRow">
                                <Grid ColumnSpacing="12" RowSpacing="2" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{x:Bind Name}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{x:Bind StateText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Text="{x:Bind Detail}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Text="Every required check must pass before setup can continue."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="StartOverButton"
                Grid.Column="0"
                Content="Start Over"
                Click="StartOverButton_Click"
                Visibility="Collapsed"
                AutomationProperties.Name="Start server setup over" />
            <TextBlock
                x:Name="BlockerText"
                Grid.Column="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <Button
                x:Name="BackButton"
                Grid.Column="2"
                Content="Back"
                Click="BackButton_Click"
                Visibility="Collapsed"
                AutomationProperties.Name="Back" />
            <Button
                x:Name="ContinueButton"
                Grid.Column="3"
                Content="Continue"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="False"
                Click="ContinueButton_Click"
                AutomationProperties.Name="Continue setup" />
        </Grid>
    </Grid>
</Page>
