<Page
    x:Class="Helicoid.Manager.Views.ServerSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="Server Setup" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Windows manager offers This Computer (Windows local) or Existing Linux Server (SSH). Version 1 does not install a local macOS server or install Windows hosting remotely."
                TextWrapping="Wrap"
                Style="{StaticResource BodyTextBlockStyle}" />

            <InfoBar
                IsOpen="True"
                Severity="Warning"
                Title="Setup not available yet"
                Message="This app shows the real setup steps. It does not install or change server software on this computer yet." />

            <TextBlock Text="Choose hosting" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="WindowsLocalButton" Content="This Computer (Windows local)" Click="WindowsLocal_Click" />
                <Button x:Name="LinuxSshButton" Content="Existing Linux Server (SSH)" Click="LinuxSsh_Click" />
            </StackPanel>

            <TextBlock Text="Current step" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="CurrentStepText" Text="Choose hosting" Style="{StaticResource BodyStrongTextBlockStyle}" />

            <TextBlock Text="Route steps" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="StepsList" SelectionMode="None" />

            <TextBlock Text="Host checks" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="HostChecksList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding Result}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Run Host Checks" Click="RunChecks_Click" />
                <Button Content="Install" Click="Install_Click" IsEnabled="False" />
            </StackPanel>

            <InfoBar
                x:Name="ReadyInfo"
                IsOpen="False"
                Severity="Success"
                Title="Server Ready for Enrollment"
                Message="Setup ends at Ready for Enrollment. Deployment Verified is separate later evidence and is never marked by finishing setup." />
        </StackPanel>
    </ScrollViewer>
</Page>
