<Page
    x:Class="Helicoid.Manager.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="520">
            <TextBlock Text="Connect to Server" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar
                x:Name="ModeInfo"
                IsOpen="True"
                Severity="Informational"
                Title="Server access"
                Message="Sign-in is not available in this build." />

            <TextBox
                x:Name="UsernameBox"
                Header="Username"
                IsEnabled="False"
                TextChanged="UsernameBox_TextChanged" />

            <PasswordBox
                x:Name="PasswordBox"
                Header="Password"
                IsEnabled="False" />

            <TextBox
                x:Name="ManagerIdentityBox"
                Header="Manager identity (development label)"
                IsEnabled="False"
                TextChanged="ManagerIdentityBox_TextChanged" />

            <TextBlock
                Text="The manager identity is a local development label. It is not a production cryptographic identity."
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SignInButton" Content="Sign In" IsEnabled="False" Click="SignIn_Click" />
                <Button x:Name="SignOutButton" Content="Sign Out" IsEnabled="False" Click="SignOut_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
