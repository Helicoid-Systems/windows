<Page
    x:Class="Helicoid.Manager.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="Page_KeyDown">
    <Grid Padding="24" RowSpacing="16" MaxWidth="600" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <TextBlock x:Name="TaskTitle" Text="Connect to Server" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <StackPanel x:Name="CredentialFields" Spacing="12">
                    <TextBox x:Name="UsernameBox" Header="Username" TextChanged="UsernameBox_TextChanged" />
                    <PasswordBox x:Name="PasswordBox" Header="Password" PasswordChanged="Secret_Changed" />
                    <TextBox x:Name="ManagerIdentityBox" Header="Development manager label" Visibility="Collapsed" TextChanged="ManagerIdentityBox_TextChanged" />
                </StackPanel>
                <StackPanel x:Name="TotpPanel" Spacing="8" Visibility="Collapsed">
                    <PasswordBox x:Name="TotpBox" Header="Verification code" PasswordChanged="Secret_Changed" />
                </StackPanel>
                <Expander x:Name="Details" Header="Details" Visibility="Collapsed" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
            <ProgressRing x:Name="Activity" Grid.Column="2" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Signing in" />
            <Button x:Name="SignInButton" Grid.Column="3" Content="Sign In" Click="SignIn_Click" />
            <Button x:Name="SubmitTotpButton" Grid.Column="3" Content="Verify" Click="SubmitTotp_Click" Visibility="Collapsed" />
            <Button x:Name="SignOutButton" Grid.Column="3" Content="Sign Out" Click="SignOut_Click" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
