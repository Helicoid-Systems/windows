<Page
    x:Class="Helicoid.Manager.Views.ComputersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Helicoid.Manager.ViewModels"
    xmlns:views="using:Helicoid.Manager.Views">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="GridTileTemplate" x:DataType="vm:ComputerTile">
            <StackPanel Spacing="4" Padding="8"
                Width="{x:Bind PreviewExtent, Mode=OneWay}">
                <Border
                    Height="{x:Bind PreviewHeight, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4">
                    <StackPanel VerticalAlignment="Center" Spacing="2" Padding="8">
                        <TextBlock
                            Text="{x:Bind PreviewTitle}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            HorizontalAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Text="{x:Bind PreviewDetail}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
                <TextBlock
                    Text="{x:Bind Name}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Text="{x:Bind TrustedUserName}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind HasTrustedUser, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Text="{x:Bind ExceptionText}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind HasException, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ListRowTemplate" x:DataType="vm:ComputerTile">
            <Grid ColumnSpacing="12" Padding="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        Text="{x:Bind Name}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind TrustedUserName}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind HasTrustedUser, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ExceptionText}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Visibility="{x:Bind HasException, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind PreviewTitle}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanel">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanel">
            <ItemsStackPanel />
        </ItemsPanelTemplate>
        <MenuFlyout x:Key="InventoryContextMenu">
            <MenuFlyoutItem Text="View Screen" Click="ViewScreen_Click" />
            <MenuFlyoutItem Text="Clear Selection" Click="ClearSelection_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarToggleButton x:Name="GridListToggle" Icon="ViewAll" Label="Grid" IsChecked="True" Checked="GridListToggle_Checked" Unchecked="GridListToggle_Unchecked" />
            <AppBarButton Icon="Zoom" Label="Preview Size">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Compact" Tag="Compact192" Click="PreviewSize_Click" />
                        <MenuFlyoutItem Text="Standard" Tag="Standard256" Click="PreviewSize_Click" />
                        <MenuFlyoutItem Text="Large" Tag="Large320" Click="PreviewSize_Click" />
                        <MenuFlyoutItem Text="Extra Large" Tag="ExtraLarge448" Click="PreviewSize_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="PauseResumeButton" Icon="Pause" Label="Pause Monitoring" Click="PauseResume_Click" />
            <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click" />
            <AppBarButton Icon="Clear" Label="Clear Filters" Click="ClearFilters_Click" />
            <AppBarToggleButton x:Name="PanelToggle" Icon="People" Label="Computers Panel" Checked="PanelToggle_Checked" Unchecked="PanelToggle_Unchecked" />
            <AppBarButton Icon="Clear" Label="Clear Selection" Click="ClearSelection_Click" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                Grid.Column="0"
                x:Name="SearchBox"
                PlaceholderText="Search computers"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                Grid.Column="1"
                x:Name="StatusFilterBox"
                MinWidth="140"
                HorizontalAlignment="Right"
                SelectionChanged="StatusFilterBox_SelectionChanged">
                <ComboBoxItem Content="All" IsSelected="True" />
                <ComboBoxItem Content="Online" />
                <ComboBoxItem Content="Needs Attention" />
            </ComboBox>
        </Grid>

        <TextBlock x:Name="InventoryStatus" Grid.Row="2" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Computers panel: inclusion only. Auto column; collapsed Expander
                 must not reserve width (header still visible for re-open). -->
            <Expander
                Grid.Column="0"
                x:Name="ComputersPanel"
                Header="Computers"
                Visibility="Collapsed"
                Collapsed="ComputersPanel_Collapsed"
                IsExpanded="False"
                MinWidth="0"
                VerticalAlignment="Top">
                <StackPanel Spacing="8" MinWidth="220">
                    <CheckBox
                        x:Name="AllComputersCheck"
                        Content="All Computers"
                        IsThreeState="True"
                        Click="AllComputersCheck_Click" />
                    <ItemsControl x:Name="GroupCheckList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InclusionGroupRow">
                                <CheckBox
                                    Content="{x:Bind Name}"
                                    IsThreeState="True"
                                    IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    Click="GroupCheck_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="ComputerCheckList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComputerTile">
                                <CheckBox
                                    Content="{x:Bind Name}"
                                    IsChecked="{x:Bind IsIncludedInOverview, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    Click="ComputerCheck_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    x:Name="ScopeLine"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="InventoryHost"
                        SelectionMode="Extended"
                        ItemTemplate="{StaticResource GridTileTemplate}"
                        ItemsPanel="{StaticResource WrapPanel}"
                        SelectionChanged="InventoryHost_SelectionChanged"
                        DoubleTapped="InventoryHost_DoubleTapped"
                        RightTapped="InventoryHost_RightTapped"
                        KeyDown="InventoryHost_KeyDown"
                        ContextFlyout="{StaticResource InventoryContextMenu}"
                        Canvas.ZIndex="1" />

                    <StackPanel
                        x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Canvas.ZIndex="2">
                        <TextBlock
                            x:Name="EmptyStateTitle"
                            Style="{StaticResource BodyTextBlockStyle}"
                            HorizontalAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="EmptyStateDetail"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
