<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Helicoid.Manager</RootNamespace>
    <AssemblyName>Helicoid.Manager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Development bundle: x64 + unpackaged. Packaged .NET apps cannot be
         ProcessorArchitecture neutral; Platform and RID stay pinned to win-x64.
         Unsigned development output uses WindowsPackageType=None (CI-verified). -->
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Working name only. Durable package identity requires B01. -->
    <AssemblyTitle>Helicoid Manager</AssemblyTitle>
    <Product>Helicoid</Product>
    <Company>Helicoid Systems</Company>
    <!-- Role-specific Explorer PE icon from branding/generated. -->
    <ApplicationIcon>..\..\branding\generated\hs-manager-windowsicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\brand\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Staged beside the published exe for AppWindow.SetIcon (AppContext.BaseDirectory). -->
    <Content Include="..\..\branding\generated\hs-manager-windowsicon.ico">
      <Link>hs-manager-windowsicon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helicoid.Domain\Helicoid.Domain.csproj" />
  </ItemGroup>

</Project>
