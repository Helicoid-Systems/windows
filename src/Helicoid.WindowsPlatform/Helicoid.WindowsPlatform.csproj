<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Helicoid.WindowsPlatform</RootNamespace>
    <AssemblyName>Helicoid.WindowsPlatform</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Reusable Windows platform module for native observer and IPC. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helicoid.Domain\Helicoid.Domain.csproj" />
    <ProjectReference Include="..\Helicoid.WorkerTransport\Helicoid.WorkerTransport.csproj" />
    <Compile Include="..\..\..\..\modules\core\webrtc-native\native\wrappers\HsWebRtcWrapper.cs"
             Link="Native\HsWebRtcWrapper.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helicoid.WindowsIntegrationTests" />
    <InternalsVisibleTo Include="Helicoid.Domain.Tests" />
  </ItemGroup>

</Project>
